#!/bin/sh
# work-link owns location classification, including physical storage worktrees.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
result=$(work-link --ensure python/.venv)
status=$(printf '%s\n' "$result" | awk -F '\t' -v target="$root/python/.venv" '
    $2 == target { count++; status = $1 }
    END { if (count != 1) exit 1; print status }
') || { echo 'setup: expected one work-link result for python/.venv' >&2; exit 1; }
case "$status" in
    outside|external) synced=false ;;
    ok|created|relinked|materialized|rewritten)
        [ -L python/.venv ] && [ -d python/.venv ] || {
            echo 'setup: expected a live managed python/.venv link' >&2; exit 1;
        }
        command -v attr >/dev/null
        synced=true ;;
    *) echo "setup: work-link refused environment preparation: $status" >&2; exit 1 ;;
esac
(cd python && uv sync --frozen)
cd ts
npm ci
if "$synced"; then attr -s com.dropbox.ignored -V 1 node_modules; fi
npm run build
if "$synced"; then attr -s com.dropbox.ignored -V 1 dist; fi
